# Co-Work Cloud ERP — Environment Variables
# Copy this file to .env and fill in the values

# ============================================
# General
# ============================================
NODE_ENV=development
DEV_SANDBOX_ACTIVE=true
DEV_BYPASS_AUTH=true

# ============================================
# Backend
# ============================================
PORT=5001

# ============================================
# Ollama / Hermes AI
# ============================================
OLLAMA_HOST=http://host.docker.internal:11434
HERMES_MODEL=hermes3:8b

# ============================================
# Firebase (Admin SDK)
# ============================================
# Option 1: Service account JSON string
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Option 2: Service account file path
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option 3: ADC (Application Default Credentials) — no env vars needed

# Firebase Emulator Hosts (auto-set in sandbox mode)
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# ============================================
# Frontend (Vite env vars must start with VITE_)
# ============================================
VITE_API_URL=http://localhost:5001
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-project
VITE_FIREBASE_STORAGE_BUCKET=demo-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
